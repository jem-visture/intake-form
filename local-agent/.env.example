# Copy this file to local-agent/.env. The populated file is ignored by Git.
LOCAL_AGENT_PORT=8788
LOCAL_AGENT_HOST=127.0.0.1

# Add the exact deployed Vercel origin after deployment, separated by commas if needed.
# Example: https://your-project.vercel.app
LOCAL_AGENT_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Ollama runs locally and requires no API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_MS=240000

# For connectivity testing only: return a clearly labelled safe dummy estimate if
# the tiny model fails strict validation. Set false with the stronger Mac Studio model.
LOCAL_AGENT_CONNECTIVITY_MODE=true

# Request safety limits.
LOCAL_AGENT_MAX_REQUEST_MB=25
LOCAL_AGENT_MAX_PHOTOS=6
